{note:::/error.nsb}

{note::throw(message?), throws a command error in an embed
@param {string} message? - Message, optional}
{set:throw()|{ignore:
    {embedjson:{
      "author": {
        "icon_url": {jsonify:{avatar}},
        "name": {jsonify:{user}#{discrim}},
        "url": "https://discord.com/users/{id}"
      },
      "footer": {
        "icon_url": "https://cdn.discordapp.com/attachments/1377013190965203035/1378220702422925412/speed.gif?ex=68b470cd&is=68b31f4d&hm=82e4a26208f6ad8627b760a8bbbcb9801289cf050b04e728e75f4ca4b1df2e07&",
        "text": "salagatavideo"
      },
      "color": 15746887,
      "description": {jsonify:{get:throw.message|An error has ocurred!}},
      "title": "⚠️ Command Error",
      "type": "inaba"
    }}

    {delete:throw.message}
}}