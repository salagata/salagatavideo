}

{note:{getglobal:SALAGATAVIDEO_TOKEN}}
{set:API|https://jadestoat.onpella.app/api/v1}

{note:Prevent external execution}
{if:{ismaintag}|=|false|then:
    {note:Soon make a system to approve parent tag ids like the previous alias system}
    {exit:https://cdn.discordapp.com/attachments/1124758334805909509/1404622374522847352/image.png?ex=689bdc06&is=689a8a86&hm=204e147dccbb758d5b6bb8d7ac216497fd6eaa8b5a61a3d75e1138ed44e595c3&}
}

{note:Routers}

{note::.tag {tagname} list <match>
<match> - Optional search parameter}
{if:{get:match}|=|false|then:
{eval:{replace:(?<!\\)"list(?<!\\)",(?<!\\)"(?<match>.*?)(?<!\\)"|with:{ignore:
    {set:match|true}
    {set:params.match|$<match>}
}|in:{reverse:{substring:{reverse:{substring:{replace:\u007c|\$&|{get:__args}}|1}}|1}}}}}
{if:{get:match}|=|true|then:
    WIP
    {delete:params.match}
}

{note::.tag {tagname} list 
Shows the effect list}
{if:{get:match}|=|false|then:
{eval:{replace:(?<!\\)"list(?<!\\)"|with:{ignore:
    {set:match|true}
}|in:{reverse:{substring:{reverse:{substring:{replace:\u007c|\$&|{get:__args}}|1}}|1}}}}}
{if:{get:match}|=|true|then:
    {note:Load array library in local}
    {eval:{text:https://cdn.discordapp.com/attachments/1454915762115444786/1455727090287640627/arraystring.nsb?ex=697613c0&is=6974c240&hm=97613c694b1f2a0cdcfac63851492b2b00ee097707b93bd3e5fd0129851303e1&}}
    
    {note:Get effect}
    {set:fetch(url)|{get:API}/effects/list/}
    {eval:{get:fetch()}}

    {set:effectList|{get:retx}}
    {set:array.__this|{get:retx}}
    
    {eval:{get:array.length}}
    
    {set:array.slice(start)|0}
    {set:array.slice(end?)|200}
    {eval:{get:array.slice()}}
    {set:match|false}
}

{note::.tag {tagname} <effect>
<effect> - Effect name}
{if:{get:match}|=|false|then:
{eval:{replace:^(?<!\\)"(?<effect>.*?)(?<!\\)"(.*)|with:{ignore:
    {set:match|true}
    {set:params.effect|$<effect>}
}|in:{reverse:{substring:{reverse:{substring:{replace:\u007c|\$&|{get:__args}}|1}}|1}}}}}
{if:{get:match}|=|true|then:
    {note:Get effect}
    {set:fetch(url)|{get:API}/effects/list/{url:{get:params.effect}}}
    {eval:{get:fetch()}}

    {set:effect|{get:retx}}
    {set:code|{eval:{traversejson:code|{get:effect}}}}


    {note:Load effect(simplified)}

    {set:finalCode|{replace:#|0|{get:code}}}
    {iscript:load {iv} 0
{get:finalCode}
render 0 default salagatavideo}

    {delete:params.effect}
    {set:match|false}
    
}


