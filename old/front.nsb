-# Last updated on {traversejson:lastUpdate|{getglobal:metaInfo}}
{embedjson:{
    "color": {get:rcg},
    "author": {
        "icon_url": "{avatar}",
        "name": "{user}"
    },
    "title": "Basic Usage:",
    "description": "```\n.tag {tagname} <effect> <effect_args> <subcommand> <subcommand-args>\n```",
    "footer": {
        "icon_url": "https://cdn.discordapp.com/attachments/1377013190965203035/1378220702422925412/speed.gif?ex=68b470cd&is=68b31f4d&hm=82e4a26208f6ad8627b760a8bbbcb9801289cf050b04e728e75f4ca4b1df2e07&",
        "text": "salagatavideo"
    },
    "fields": [
        {
            "name": "Tips:",
            "value": "\nTo see the command list: ```\n.tag {tagname} list\n```\nHelp to use salagatavideo:\n```\n.tag {tagname} help\n```\nHelp for a command:\n```\n.tag {tagname} help <effect>\n```"
        }
    ]
}}
|else:

